# GTFS oficial del Área Metropolitana (python scripts/download_gtfs.py)
GTFS_PATH=data/gtfs_amg.zip
# Base derivada del GTFS; se reconstruye sola si falta o si el zip cambia
TRANSIT_DB_PATH=data/transit.db
LANDMARKS_PATH=data/landmarks.json
INCIDENTS_DB_PATH=data/incidents.db
FEEDBACK_DB_PATH=data/feedback.db
REDIS_URL=redis://localhost:6379/0
ENVIRONMENT=development
LOG_LEVEL=INFO
SESSION_TIMEOUT_MINUTES=10
GPS_POSITION_TTL_SECONDS=30
WEATHER_LATITUDE=20.6736
WEATHER_LONGITUDE=-103.3438
WEATHER_TIMEOUT_SECONDS=5
USE_MOCK_WEATHER=false
# Skip Redis for faster local startup (dashboard + API work in memory)
USE_MEMORY_CACHE=true
# Simulate live buses/trains on official GTFS routes (writes to Redis or memory)
DEMO_SIMULATOR=true
# Región cuyas rutas simula la flota (vacío = toda la red)
DEMO_REGION=tonala_cucei
# Estilo del mapa base (MapLibre). Sin clave: OpenFreeMap. Para otro proveedor, su URL con tu clave.
MAP_STYLE_URL=https://tiles.openfreemap.org/styles/dark
DEMO_SIMULATOR_INTERVAL=2.5

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
REQUIRE_TWILIO_SIGNATURE=false
