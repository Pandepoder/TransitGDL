GTFS_PATH=data/gtfs_guadalajara.zip
INCIDENTS_DB_PATH=data/incidents.db
FEEDBACK_DB_PATH=data/feedback.db
REDIS_URL=redis://localhost:6379/0
ENVIRONMENT=development
LOG_LEVEL=INFO
SESSION_TIMEOUT_MINUTES=10
GPS_POSITION_TTL_SECONDS=30
WEATHER_LATITUDE=20.6736
WEATHER_LONGITUDE=-103.3438
WEATHER_TIMEOUT_SECONDS=5
USE_MOCK_WEATHER=false
# Skip Redis for faster local startup (dashboard + API work in memory)
USE_MEMORY_CACHE=true
# Simulate live buses/trains on official GTFS routes (writes to Redis or memory)
DEMO_SIMULATOR=true
DEMO_SIMULATOR_INTERVAL=2.5

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
REQUIRE_TWILIO_SIGNATURE=false
